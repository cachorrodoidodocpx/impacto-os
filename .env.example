# Copie este arquivo para ".env" quando for rodar localmente.
# No Railway, essas mesmas variáveis são configuradas em Settings > Variables (não use arquivo .env lá).

# --- Login do painel admin (só você acessa) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# --- Segurança da sessão de login ---
# Qualquer frase longa e aleatória serve. Troque por algo só seu.
SESSION_SECRET=troque-este-segredo-por-uma-frase-aleatoria-grande

# --- Banco de dados Postgres ---
# No Railway: crie um serviço "PostgreSQL" no mesmo projeto e conecte a URL
# dele aqui (ou use uma referência de variável, veja o README).
# Localmente, só preencha se você tiver um Postgres rodando na sua máquina
# ou usar a URL pública do Postgres do Railway.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# --- Ambiente ---
# Em produção (Railway), deixe "production". Rodando na sua máquina, use
# "development" — em "production" os cookies exigem HTTPS, que não existe
# em localhost.
NODE_ENV=development
PORT=3000
