<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/admin-head', { title: order.clientName }) %>
<body class="admin">
<%
function badgeClass(status) {
  if (status === 'aguardando_pagamento') return 'badge-pending';
  if (status === 'pago') return 'badge-paid';
  if (status === 'pronto') return 'badge-done';
  if (status === canceled) return 'badge-canceled';
  return 'badge-progress';
}
%>
<%- include('partials/admin-nav') %>
<div class="wrap">
  <a href="/admin" class="back-link">&larr; Voltar para os pedidos</a>

  <% if (justCreated) { %>
  <div class="alert alert-success">Pedido criado! Copie o link abaixo e envie para o cliente.</div>
  <% } %>

  <div class="order-heading">
    <div>
      <h1><%= order.clientName %></h1>
      <p class="sub"><%= order.orderTitle %></p>
    </div>
    <span class="badge <%= badgeClass(order.status) %>" style="font-size: 14px; padding: 8px 16px;">
      <%= isCanceled ? 'Cancelado' : stages[currentIndex].label %>
    </span>
  </div>

  <div class="link-box">
    <code><%= link %></code>
    <button class="btn btn-ghost btn-sm js-copy" data-copy-text="<%= link %>" data-label-default="Copiar" data-label-copied="Copiado!">Copiar</button>
  </div>

  <div class="actions-row">
    <a href="<%= link %>" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Abrir link do cliente</a>
    <% if (whatsapp) { %>
    <a href="<%= whatsapp %>" target="_blank" rel="noopener" class="btn btn-flame btn-sm">Enviar no WhatsApp</a>
    <% } %>
  </div>

  <% if (!isCanceled) { %>
  <div class="panel">
    <h2>Etapa de produção</h2>
    <div class="stepper">
      <% stages.forEach(function(stage, i) { %>
      <form method="POST" action="/admin/pedidos/<%= order.id %>/status" style="margin:0;">
        <input type="hidden" name="status" value="<%= stage.key %>" />
        <button type="submit" class="step-pill <%= i < currentIndex ? 'is-done' : (i === currentIndex ? 'is-current' : '') %>">
          <%= stage.short %>
        </button>
      </form>
      <% }); %>
    </div>
    <% if (nextStage) { %>
    <form method="POST" action="/admin/pedidos/<%= order.id %>/status" style="margin:0;">
      <input type="hidden" name="action" value="avancar" />
      <button type="submit" class="btn btn-flame">Avançar para "<%= nextStage.short %>"</button>
    </form>
    <% } else { %>
    <p class="hint">Este pedido chegou à última etapa.</p>
    <% } %>
  </div>
  <% } else { %>
  <div class="panel">
    <h2>Pedido cancelado</h2>
    <p class="hint">Você pode reativar escolhendo uma etapa abaixo.</p>
    <div class="stepper">
      <% stages.forEach(function(stage) { %>
      <form method="POST" action="/admin/pedidos/<%= order.id %>/status" style="margin:0;">
        <input type="hidden" name="status" value="<%= stage.key %>" />
        <button type="submit" class="step-pill"><%= stage.short %></button>
      </form>
      <% }); %>
    </div>
  </div>
  <% } %>

  <div class="panel">
    <h2>Editar dados do pedido</h2>
    <form method="POST" action="/admin/pedidos/<%= order.id %>">
      <div class="form-row">
        <div class="field">
          <label for="clientName">Nome do cliente</label>
          <input type="text" id="clientName" name="clientName" required value="<%= order.clientName %>" />
        </div>
        <div class="field">
          <label for="clientPhone">WhatsApp do cliente</label>
          <input type="tel" id="clientPhone" name="clientPhone" value="<%= order.clientPhone %>" />
        </div>
      </div>
      <div class="field">
        <label for="orderTitle">Pedido</label>
        <input type="text" id="orderTitle" name="orderTitle" required value="<%= order.orderTitle %>" />
      </div>
      <div class="field">
        <label for="description">Descrição (peças, tamanhos e ajustes)</label>
        <textarea id="description" name="description"><%= order.description %></textarea>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="price">Valor total (R$)</label>
          <input type="number" id="price" name="price" step="0.01" min="0" required value="<%= order.price %>" />
        </div>
        <div class="field">
          <label for="deadline">Prazo de entrega</label>
          <input type="date" id="deadline" name="deadline" value="<%= order.deadline %>" />
        </div>
      </div>
      <button type="submit" class="btn btn-flame">Salvar alterações</button>
    </form>
  </div>

  <div class="panel danger-zone">
    <h2>Zona de risco</h2>
    <p>Cancelar avisa o cliente pelo link. Excluir apaga o pedido para sempre e o link para de funcionar.</p>
    <div class="actions-row">
      <% if (!isCanceled) { %>
      <form method="POST" action="/admin/pedidos/<%= order.id %>/status"
        data-confirm="Cancelar este pedido? O cliente verá que foi cancelado no link dele.">
        <input type="hidden" name="status" value="<%= canceled %>" />
        <button type="submit" class="btn btn-danger btn-sm">Cancelar pedido</button>
      </form>
      <% } %>
      <form method="POST" action="/admin/pedidos/<%= order.id %>/excluir"
        data-confirm="Excluir este pedido definitivamente? Essa ação não pode ser desfeita.">
        <button type="submit" class="btn btn-danger btn-sm">Excluir pedido</button>
      </form>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
