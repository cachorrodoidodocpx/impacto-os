<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/admin-head', { title: 'Novo pedido' }) %>
<body class="admin">
<%- include('partials/admin-nav') %>
<div class="wrap">
  <a href="/admin" class="back-link">&larr; Voltar para os pedidos</a>

  <div class="panel">
    <h2>Cadastrar novo pedido</h2>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/pedidos">
      <div class="form-row">
        <div class="field">
          <label for="clientName">Nome do cliente</label>
          <input type="text" id="clientName" name="clientName" required autofocus
            value="<%= order && order.clientName ? order.clientName : '' %>" placeholder="Ex: Julia" />
        </div>
        <div class="field">
          <label for="clientPhone">WhatsApp do cliente (opcional)</label>
          <input type="tel" id="clientPhone" name="clientPhone" placeholder="Ex: 41 99999-0000"
            value="<%= order && order.clientPhone ? order.clientPhone : '' %>" />
        </div>
      </div>

      <div class="field">
        <label for="orderTitle">Pedido</label>
        <input type="text" id="orderTitle" name="orderTitle" required
          placeholder="Ex: 2 Conjuntos Run - Divino"
          value="<%= order && order.orderTitle ? order.orderTitle : '' %>" />
      </div>

      <div class="field">
        <label for="description">Descrição (peças, tamanhos e ajustes)</label>
        <textarea id="description" name="description"
          placeholder="Ex: 2 Top Nadador tamanho M e 2 Short corrida tamanho P, cós 2 dedos maior"><%= order && order.description ? order.description : '' %></textarea>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="price">Valor total (R$)</label>
          <input type="number" id="price" name="price" step="0.01" min="0" required
            placeholder="299.90" value="<%= order && order.price ? order.price : '' %>" />
        </div>
        <div class="field">
          <label for="deadline">Prazo de entrega</label>
          <input type="date" id="deadline" name="deadline"
            value="<%= order && order.deadline ? order.deadline : '' %>" />
        </div>
      </div>

      <p class="hint" style="margin-bottom: 18px;">
        O pedido começa como <strong>Aguardando pagamento</strong>. O link de acompanhamento é gerado
        automaticamente assim que você confirmar.
      </p>

      <button type="submit" class="btn btn-flame">Confirmar e gerar link</button>
    </form>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
